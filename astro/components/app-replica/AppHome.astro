---
// The New Chat page: greeting, suggestions, connected apps and recent tasks. Fades out when a chat starts.
// The message box is separate because it moves between the two views.
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import EuFlag from "./EuFlag.astro";
import HomeComposer from "./HomeComposer.astro";
import HomeSuggestions from "./HomeSuggestions.astro";
import HomeTasks from "./HomeTasks.astro";
import AppChat from "./AppChat.astro";
import { REPLICA } from "./content";
---

<!-- trust marks, top right -->
<div class="absolute right-[24px] top-[24px] flex items-center gap-6 text-[#979899]">
  <Icon name="shieldOff" stroke={2} />
  <Icon name="chip" stroke={2} class="text-[#54738c]" />
  <EuFlag />
</div>

<div class="absolute inset-0 transition-opacity duration-500 group-data-[view=chat]/app:pointer-events-none group-data-[view=chat]/app:opacity-0">
  <Mark class="absolute left-[357px] top-[164px] size-9 text-[#0c0d0d]" />
  <p class="absolute left-[409px] top-[160px] whitespace-nowrap font-['Fluso_Demo_Newsreader',Georgia,serif] text-[36px] italic leading-[44px] tracking-[-0.9px] text-[#0c0d0d]">
    {REPLICA.greeting}
  </p>
  <HomeSuggestions />
  <HomeTasks />
</div>

<AppChat />
<HomeComposer />
