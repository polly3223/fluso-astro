---
// The message box. On the New Chat page it sits mid-screen (720 wide); in a chat it moves to the bottom (600 wide).
// The animation script types into [data-typed]. Right-hand items are anchored to the right edge so the width can change.
import Icon from "./Icon.astro";
import { REPLICA } from "./content";
---

<div
  class="absolute left-[349px] top-[230px] h-[122px] w-[720px] rounded-[18px] border border-[#dadadb] bg-white transition-[left,top,width] duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] group-data-[view=chat]/app:left-[340px] group-data-[view=chat]/app:top-[597px] group-data-[view=chat]/app:w-[600px]"
>
  <p class="absolute left-4 top-[17px] text-[14px] leading-5 text-[#979899]/70 transition-opacity duration-200 group-data-[typing=on]/app:opacity-0">
    {REPLICA.composerHint}
  </p>
  <p class="absolute left-4 right-14 top-[17px] text-[14px] leading-5 text-[#0c0d0d]">
    <span data-typed></span><span class="ml-px inline-block h-[15px] w-px translate-y-[3px] bg-[#0c0d0d] opacity-0 group-data-[typing=on]/app:opacity-100 motion-safe:animate-pulse"></span>
  </p>
  <Icon name="shield" size={14} class="absolute right-[18px] top-[18px] text-[#979899]/60" />

  <Icon name="plus" class="absolute left-[17px] top-[89px] text-[#979899]" />
  <div class="absolute left-[51px] top-[88px] flex items-center gap-[6px] text-[13px] leading-[18px] text-[#979899]">
    <Icon name="home" size={14} />Home
  </div>
  <Icon name="lock" class="absolute left-[123px] top-[89px] text-[#979899]" />
  <p class="absolute left-[146px] top-[88px] text-[13px] leading-[18px] text-[#979899]">Ask me first</p>

  <Icon name="signal" size={14} class="absolute right-[144px] top-[90px] text-[#979899]" />
  <p class="absolute right-[90px] top-[88px] text-[13px] leading-[18px] text-[#979899]">Medium</p>
  <Icon name="mic" class="absolute right-[57px] top-[89px] text-[#979899]" />
  <span class="absolute right-3 top-[83px] flex size-7 items-center justify-center rounded-full bg-[#e7e8e9] text-[#979899] transition-colors duration-300 group-data-[send=on]/app:bg-[#0c0d0d] group-data-[send=on]/app:text-white">
    <Icon name="arrowUp" size={14} />
  </span>
</div>
